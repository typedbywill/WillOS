+    property var playingHistory: []
+
+    function rememberPlaying(player: MprisPlayer): void {
+        playingHistory = playingHistory.filter(p => p && p !== player && list.includes(p));
+        playingHistory.push(player);
+        props.manualActive = player;
+    }
+
+    function selectPlayingFallback(): void {
+        playingHistory = playingHistory.filter(p => p && list.includes(p) && p.isPlaying);
+        const fallback = playingHistory[playingHistory.length - 1] ?? list.find(p => p.isPlaying);
+        if (fallback)
+            props.manualActive = fallback;
+    }
+
+    onListChanged: {
+        playingHistory = playingHistory.filter(p => p && list.includes(p));
+        if (!props.manualActive || !list.includes(props.manualActive))
+            selectPlayingFallback();
+    }
 
